<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cetpa - IIS reverse proxy for app.cetpa.com.tr -> Node app on localhost:5173.
  Copied into the Plesk-created site's httpdocs root by setup-iis-proxy.ps1.
  Requires: iis-arr (ARR + URL Rewrite) chocolatey package, and ARR proxy
  feature enabled server-wide (also done by setup-iis-proxy.ps1).

  responseBufferLimit="0" is REQUIRED: the app streams Server-Sent Events
  (multi-tenant live sync). Default ARR response buffering holds the whole
  response before forwarding, which silently breaks SSE (client never gets
  live updates, only sees them after connection drops/reconnects).

  DO NOT add a <serverVariables><set name="HTTP_X_FORWARDED_PROTO".../></serverVariables>
  action here, and never add HTTP_X_FORWARDED_PROTO to the machine-wide
  system.webServer/rewrite/allowedServerVariables list. On this box, Plesk's
  own control panel site (pleskcontrolpanel, port 8443) already manages this
  exact variable internally; adding it at the apphost level collides with
  Plesk's handling and breaks the ENTIRE panel with HTTP 500.50 / Win32 183
  (ERROR_ALREADY_EXISTS) on every request. Confirmed by direct A/B test
  2026-07-01. The app does not require this header to function.
-->
<configuration>
  <system.webServer>
    <!--
      WebDAV modulunu bu site icin KALDIR. IIS'in WebDAV modulu PUT/PATCH/DELETE
      fiillerini kaciriyor ve uygulamaya (ARR reverse proxy) ulasmadan 403 text/html
      donduruyordu; boylece TUM guncelleme/silme istekleri (dbClient PATCH/DELETE,
      increment, cas) kiriliyor ve boot profil-senkronu 403 alinca uygulama acilis
      ekraninda donuyordu. Kaldirinca bu fiiller ARR kuraliyla Node'a iletilir.
      (Istemci tarafinda ayrica ozel X-Cetpa-Method tuneli var - kemer + aski.)
    -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <proxy responseBufferLimit="0" />
    <rewrite>
      <rules>
        <rule name="CetpaReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5173/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
