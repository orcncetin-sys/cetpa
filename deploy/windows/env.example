# =============================================================================
# Cetpa - Production Environment Variables (ORNEK / REFERANS)
#
# Bu dosya SIR ICERMEZ. Gercek degerler sunucudaki C:\cetpa\.env dosyasindadir
# ve o dosya git'e GIRMEZ.
#
# ---------------------------------------------------------------------------
# NEDEN SALT-ASCII (2026-08-24):
# .env'in yorum satirlarindaki Turkce karakterler ve kutu cizgileri ('-' yerine
# kullanilan uzun cizgiler) tekrar tekrar yanlis kodlamayla okunup yazilarak
# bozuldu: tek bir karakter onlarca '?' haline geldi. Sebep, PowerShell 5.1'in
# varsayilan Windows-1252 okumasi ve `Set-Content -Encoding ASCII` ile yazma
# idi (her ikisi de 2026-08-24'te duzeltildi; artik BOM'suz UTF-8 okunup
# yaziliyor). Yine de bu dosya BILEREK salt-ASCII tutuluyor: .env'e dokunan
# her arac dogru kodlamayi kullanmayabilir ve ASCII hicbir turden bozulmaz.
# Turkce karakter EKLEME - 'gercek' yerine 'gercek' yaz, okunur kalir.
#
# ONEMLI: '?' isaretleri yalnizca YORUM satirlarinda gorulduyse veri kaybi
# YOKTUR. Kontrol:
#   Select-String -Path C:\cetpa\.env -Pattern '\?' |
#     Where-Object { $_.Line -notmatch '^\s*#' }
# Bos donerse hicbir DEGER zarar gormemistir.
# =============================================================================


# -----------------------------------------------------------------------------
# ZORUNLU - bunlarsiz uygulama ayaga kalkmaz
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://KULLANICI:PAROLA@localhost:5432/VERITABANI
PORT=5173
APP_URL=https://app.cetpa.com.tr
NODE_ENV=production

# Oturum ve MFA cerezlerini imzalar. Uzun ve rastgele olmali; degistirilirse
# TUM oturumlar ve MFA dogrulamalari duser (kullanicilar yeniden giris yapar).
SESSION_TOKEN_SECRET=
MFA_COOKIE_SECRET=


# -----------------------------------------------------------------------------
# Firebase Admin SDK (kimlik dogrulama + Storage)
# -----------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=
# Tek satirda tutulur; satir sonlari \n olarak KACISLI yazilir.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Alternatif: servis hesabi JSON dosyasinin yolu (yukaridaki ikisi yerine).
GOOGLE_APPLICATION_CREDENTIALS=


# -----------------------------------------------------------------------------
# Mikro ERP (Jump) - kopru entegrasyonu
# -----------------------------------------------------------------------------
MIKRO_API_URL=
MIKRO_API_KEY=
MIKRO_IDM_EMAIL=
MIKRO_IDM_PASSWORD=
MIKRO_FIRMA_KODU=
MIKRO_FIRMA_NO=
MIKRO_SUBE_NO=
MIKRO_CALISMA_YILI=
MIKRO_KULLANICI_KODU=
MIKRO_SIFRE=
MIKRO_ALIAS=
MIKRO_JUMP_SURUM=
MIKRO_LOCAL=
MIKRO_WHITELIST_IP=
# Gece/saatlik Mikro senkronunu acar. Cok kiracili kurulumda hedef kiraci
# belirsiz kalirsa senkron ATLANIR - o yuzden COMPANY_ID'yi acikca ver.
MIKRO_CRON_SYNC=false
MIKRO_CRON_COMPANY_ID=
# Oturumu olmayan sunucu baglami (webhook, cron) icin kiraci. Bos birakilirsa
# tek kiraci varsa o kullanilir, cok kiracida islem atlanir.
SERVER_TENANT_COMPANY_ID=


# -----------------------------------------------------------------------------
# AI / Gemini - SADECE server-side. Client bundle'a GIRMEMELI.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Varsayilan: gemini-flash-latest. Sabit surum yazma - model emekli edilince
# sessizce kirilir (2026-07-20'de yasandi).
GEMINI_MODEL=


# -----------------------------------------------------------------------------
# E-posta (Resend) ve operasyon uyarilari
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Dogrulanmis alan adindan gonderilmeli; aksi halde Resend 403 doner ve uyari
# postalari sessizce ulasmaz.
RESEND_FROM=
OPS_ALERT_EMAIL=
REPORT_RECIPIENT_EMAIL=
# 'true' ise bekci her kosuda posta atar (normalde yalniz durum degisince).
OPS_ALERT_ALWAYS=false
# GET /api/ops/summary icin paylasilan sir.
OPS_SUMMARY_TOKEN=
WEEKLY_REPORT_ENABLED=false


# -----------------------------------------------------------------------------
# Super-admin (SaaS operatoru) - kiraci yonetim paneli yetkisi
# Virgulle ayrilmis e-posta listesi.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAILS=


# -----------------------------------------------------------------------------
# Yedekleme
# -----------------------------------------------------------------------------
BACKUP_DIR=C:\cetpa\backups
UPLOAD_DIR=
PG_DUMP_PATH=
# rclone hedefi (ornek: gdrive:cetpa-yedek). BOS ise off-site yukleme yapilmaz.
# STAGING'de MUTLAKA bos birak - yoksa staging gercek yedeklerin uzerine yazar.
RCLONE_REMOTE=
RCLONE_PATH=


# -----------------------------------------------------------------------------
# Log budama (disk kesintisi onlemi - 2026-08-24)
# -----------------------------------------------------------------------------
CETPA_LOG_DIR=C:\cetpa\logs
# Dondurulmus loglar bu butceyi asinca en eskiden baslayarak silinir.
CETPA_LOG_BUDGET_MB=500


# -----------------------------------------------------------------------------
# Odeme
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=


# -----------------------------------------------------------------------------
# Shopify
# -----------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STORE_URL=
SHOPIFY_API_KEY=
SHOPIFY_ACCESS_TOKEN=
# Webhook imza dogrulamasi - BOS BIRAKMA, aksi halde sahte siparis kabul edilir.
SHOPIFY_WEBHOOK_SECRET=
# VITE_ onekli degiskenler CLIENT BUNDLE'A GIRER. Buraya gizli token koyma.
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# Pazaryerleri
# -----------------------------------------------------------------------------
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
HEPSIBURADA_MERCHANT_ID=
HEPSIBURADA_USERNAME=
HEPSIBURADA_PASSWORD=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_REGION=
AMAZON_SP_MARKETPLACE_ID=


# -----------------------------------------------------------------------------
# Diger ERP / muhasebe entegrasyonlari (Mikro'ya alternatif)
# -----------------------------------------------------------------------------
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
LOGO_API_URL=
LOGO_API_KEY=
LOGO_FIRM_NO=
LUCA_API_URL=
LUCA_BASE_URL=
LUCA_API_KEY=
LUCA_COMPANY_ID=
SAP_SERVICE_LAYER_URL=
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ENVIRONMENT=
DYNAMICS_COMPANY_ID=


# -----------------------------------------------------------------------------
# Kargo takibi
# -----------------------------------------------------------------------------
ARAS_API_KEY=
MNG_API_KEY=
YURTICI_API_KEY=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
DHL_API_KEY=


# -----------------------------------------------------------------------------
# WhatsApp / SMS
# -----------------------------------------------------------------------------
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=
WHATSAPP_360DIALOG_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=


# -----------------------------------------------------------------------------
# Diger
# -----------------------------------------------------------------------------
EXCHANGE_RATE_API_KEY=
SERVER_PUBLIC_IP=
# SSE ilk yuklemede tek koleksiyondan cekilecek azami satir.
STREAM_INIT_MAX_ROWS=
PGHOST=
PGPORT=
