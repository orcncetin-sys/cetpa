LUCA_API_URL=
LUCA_BASE_URL=
LUCA_API_KEY=
LUCA_COMPANY_ID=
SAP_SERVICE_LAYER_URL=
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ENVIRONMENT=
DYNAMICS_COMPANY_ID=


# -----------------------------------------------------------------------------
