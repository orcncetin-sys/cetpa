{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    // 2026-08-26: strictNullChecks ACIK. Bu proje "sessiz sifir/undefined"
    // sinifindan defalarca zarar gordu (Mikro alanlari, tarih cozumleme,
    // stok miktarlari). Derleyici artik o yollari yakaliyor.
    // ONEMLI: bir hatayi `?? 0` ile kapatmak YASAK - CLAUDE.md kurali:
    // "Dis sistemden gelen sayisal alan yoksa 0 degil, BILINMIYOR".
    // 2026-08-26: TAM strict. strictNullChecks acildiktan sonra kalan
    // bayraklarin (noImplicitAny, strictFunctionTypes, strictBindCallApply,
    // strictPropertyInitialization, noImplicitThis, useUnknownInCatchVariables,
    // alwaysStrict) maliyeti yalnizca 31 hataydi — olculdu, tahmin degil.
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
