# ─────────────────────────────────────────────────────────────────────────────
# Cetpa — Production Environment Variables
# VDS'de: cp .env.production.example .env.production
#         nano .env.production   (gerçek değerleri gir)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5173
NODE_ENV=production

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Dosyayı /opt/cetpa/service-account.json olarak kaydet
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# ── AI / Gemini (SADECE server-side — client bundle'a girMEsin) ──────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Mikro ERP (JumpBulut) ────────────────────────────────────────────────────
MIKRO_IDM_EMAIL=orcun@cetpa.com.tr
MIKRO_IDM_PASSWORD=your_mikro_idm_password
# LOKAL Jump kurulumu (V17 sunucuda kurulu) => http://localhost:8094/Api/APIMethods
#   V16 icin port 8084. Bu modda Authorization/token YOK, Alias & ApiKey kullanilmaz;
#   yalniz MIKRO_KULLANICI_KODU + MIKRO_SIFRE gerekir.
# BULUT (JumpBulut) => https://jumpbulutapigw.mikro.com.tr/ApiJB/ApiMethods (OIDC token + Alias)
# Mod URL'den otomatik secilir; gerekirse MIKRO_LOCAL=1/0 ile ezilir.
MIKRO_API_URL=http://localhost:8094/Api/APIMethods
MIKRO_ALIAS=XCXY-8332
MIKRO_FIRMA_KODU=01
MIKRO_CALISMA_YILI=2026
MIKRO_API_KEY=TESTAPKEY
MIKRO_KULLANICI_KODU=SRV
MIKRO_SIFRE=your_md5_hash_here
MIKRO_FIRMA_NO=0
MIKRO_SUBE_NO=0
MIKRO_CRON_SYNC=false

# ── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=cetpa.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── İyzico ───────────────────────────────────────────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# ── E-posta (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Cetpa <noreply@cetpa.com.tr>

# ── Opsiyonel ────────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=

# ── Ops ozeti (gunluk bulut rutini icin, SALT-OKUNUR) ──────────────────────
# Tanimliysa GET /api/ops/summary acilir (X-Ops-Token basligi veya ?token=).
# Bos birakilirsa uc KAPALIDIR. Rastgele uzun bir deger uretin.
OPS_SUMMARY_TOKEN=

# ── Operasyon Bekcisi gunluk uyarisi (SIFIR AI maliyeti, sadece e-posta) ──
# Bekci her sabah 08:30 kosuyor; BOZUK kontrol varsa buraya e-posta atar.
# Her sey yolundaysa POSTA GONDERMEZ (sessizlik = iyi haber).
# OPS_ALERT_ALWAYS=true dersen her gun ozet gelir.
OPS_ALERT_EMAIL=
OPS_ALERT_ALWAYS=false
